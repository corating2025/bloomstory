# AGNES_API_KEY: Third-party API key used first for Step 4 empathy evaluation and Step 5 card image generation.
# Configure this in Vercel Project Settings -> Environment Variables (and AI Studio Secrets if desired).
AGNES_API_KEY="YOUR_AGNES_API_KEY"

# Optional overrides for the third-party API endpoint and models:
AGNES_API_BASE_URL="https://apihub.agnes-ai.com/v1"
AGNES_CHAT_MODEL="agnes-2.0-flash"
AGNES_IMAGE_MODEL="agnes-image-2.1-flash"

# GEMINI_API_KEY: Fallback key for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
